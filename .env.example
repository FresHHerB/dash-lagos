# Configurações do Servidor
NODE_ENV=production
PORT=8001

# Configurações de Deploy
BOLT_DEPLOYMENT=true

# Configurações de Dados
# USE_DEFAULT_DATA=true  # Se true, retorna dados padrão quando não há relatórios
USE_DEFAULT_DATA=false

# Configuração de Webhook (opcional)
# WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/1234567/abcdefg
# WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz

# Configurações de CORS (se necessário restringir)
# CORS_ORIGIN=https://yourdomain.com

# Configurações de Recursos (opcional)
# MAX_MEMORY=50mb
# REQUEST_TIMEOUT=30000

# Configurações de Log (opcional)
# LOG_LEVEL=info